generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EDITOR
  CONTRIBUTOR
}

enum SubmissionStatus {
  DRAFT
  IN_REVIEW
  NEEDS_INFORMATION
  ACCEPTED
  DECLINED
}

enum AdvertisementStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  DECLINED
}

enum IssueStatus {
  DRAFT
  IN_REVIEW
  ACCEPTED
  PUBLISHED
}

enum ArticleStatus {
  DRAFT
  IN_REVIEW
  ACCEPTED
  PUBLISHED
}

enum IssuePageType {
  COVER
  INNER
  BACK_COVER
}

enum BusinessImportTaskStatus {
  RUNNING
  SUCCEEDED
  FAILED
  STOPPED
}

enum ReachoutTaskStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  STOPPED
}

enum AgentTaskStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  STOPPED
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

/// The advertiser's verdict on the ad or article copy they were sent for review.
enum PromotionContentStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

/// Where the paid promotion sale stands in the Marketer's conversation with the advertiser.
enum PromotionDealStatus {
  PROPOSED
  INTERESTED
  SIGNED_UP
  DECLINED
}

/// Where a Promote sales conversation stands.
enum PromotionSaleStatus {
  /// First email sent, no answer yet.
  PROPOSED
  /// The business is discussing options or prices.
  NEGOTIATING
  /// The business agreed to buy; the purchased drafts were created.
  PURCHASED
  DECLINED
}

/// The advertiser's verdict in one review of their ad.
enum AdReviewDecision {
  APPROVED
  CHANGES_REQUESTED
}

/// Where an advertiser's ad review came from.
enum AdReviewSource {
  /// The public review page linked from the Marketer's email.
  REVIEW_PAGE
  /// An email reply the Marketer classified.
  EMAIL
}

/// Which content a promotion package is sold with.
enum PromotionPackageKind {
  AD
  ARTICLE
}

enum TaskSource {
  AGENT
  BUSINESS_IMPORT
  REACHOUT
}

enum TaskStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  STOPPED
}

model User {
  id                  String                 @id @default(cuid())
  email               String                 @unique
  name                String
  surname             String                 @default("")
  phone               String?
  picturePath         String?
  passwordHash        String
  authVersion         Int                    @default(0)
  role                UserRole?
  active              Boolean                @default(true)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  publicationAccess   PublicationPublisher[]
  submissions         ContentSubmission[]    @relation("SubmittedContent")
  createdArticles     Article[]              @relation("ArticleAuthor")
  business            Business?
  businessImportTasks BusinessImportTask[]
  agentTasks          AgentTask[]
  reachoutTasks       ReachoutTask[]
  passwordResetTokens PasswordResetToken[]
  tasks               Task[]
  promotionDeals      PromotionDeal[]
  promotionSales      PromotionSale[]
}

model Publication {
  id                Int                    @id @default(autoincrement())
  name              String                 @unique
  slug              String                 @unique
  description       String?
  coverImagePath    String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  publisherAccess   PublicationPublisher[]
  submissions       ContentSubmission[]
  issues            Issue[]
  zipCodes          ZipCode[]
  /// Rate card the Marketer sells from (ad sizes and sponsored article placements).
  promotionPackages PromotionPackage[]
  promotionDeals    PromotionDeal[]
  promotionSales    PromotionSale[]
}

/// One priced placement on a publication's rate card, per issue.
model PromotionPackage {
  id             Int                  @id @default(autoincrement())
  publicationId  Int
  kind           PromotionPackageKind
  name           String
  description    String               @default("")
  priceCents     Int
  position       Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  publication    Publication          @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  deals          PromotionDeal[]
  advertisements Advertisement[]
  articles       Article[]
  saleItems      PromotionSaleItem[]

  @@index([publicationId, kind, position])
}

model ZipCode {
  id                      Int           @id @default(autoincrement())
  code                    String        @unique
  boundaryGeometry        Json?         @db.JsonB
  centroidLatitude        Float?
  centroidLongitude       Float?
  areaSquareMiles         Float?
  boundaryVintage         Int?
  estimatedPopulation     Int?
  populationMarginOfError Int?
  populationVintage       Int?
  publications            Publication[]
}

model PublicationPublisher {
  userId        String
  publicationId Int
  assignedAt    DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@id([userId, publicationId])
  @@index([publicationId])
}

model ContentSubmission {
  id                String            @id @default(cuid())
  title             String
  submitterName     String?
  submitterEmail    String?
  submitterPhone    String?
  postalCode        String?
  storyType         String?
  body              String
  status            SubmissionStatus  @default(DRAFT)
  publicationId     Int
  submittedByUserId String?
  businessId        Int?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  publication       Publication       @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  submittedBy       User?             @relation("SubmittedContent", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  business          Business?         @relation("SubmissionBusiness", fields: [businessId], references: [id], onDelete: SetNull)
  images            SubmissionImage[]
  article           Article?          @relation("SubmissionArticle")

  @@index([publicationId, status])
  @@index([submittedByUserId, createdAt])
  @@index([businessId])
}

model SubmissionImage {
  id           String            @id @default(cuid())
  submissionId String
  fileName     String            @unique
  originalName String
  mimeType     String
  size         Int
  createdAt    DateTime          @default(now())
  submission   ContentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, createdAt])
}

model ReachoutTask {
  id                 String             @id @default(cuid())
  status             ReachoutTaskStatus @default(PENDING)
  message            String             @default("")
  autoTriggered      Boolean            @default(false)
  businessId         Int
  subAgentId         Int?
  threadId           String?            @unique
  initialEmailSentAt DateTime?
  reminder1SentAt    DateTime?
  reminder2SentAt    DateTime?
  createdByUserId    String?
  createdAt          DateTime           @default(now())
  startedAt          DateTime?
  finishedAt         DateTime?
  updatedAt          DateTime           @updatedAt
  business           Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subAgent           SubAgent?          @relation(fields: [subAgentId], references: [id], onDelete: SetNull)
  thread             EmailThread?       @relation(fields: [threadId], references: [id], onDelete: SetNull)
  createdBy          User?              @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  registry           Task?

  @@index([businessId])
  @@index([status, createdAt])
}

model Business {
  id                Int                  @id @default(autoincrement())
  name              String
  ownerUserId       String?              @unique
  importTaskId      String?
  sourceProvider    String               @default("MANUAL")
  externalId        String?              @unique
  sourceQuery       String?
  primaryCategory   String?
  description       String?
  categories        String[]             @default([])
  addressLabel      String?
  houseNumber       String?
  street            String?
  city              String?
  state             String?
  stateCode         String?
  postalCode        String?
  countryCode       String?
  latitude          Float?
  longitude         Float?
  distanceMeters    Int?
  phone             String?
  email             String?
  website           String?
  sourceRetrievedAt DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  owner             User?                @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  importTask        BusinessImportTask?  @relation(fields: [importTaskId], references: [id], onDelete: SetNull)
  ads               Advertisement[]
  reachoutTasks     ReachoutTask[]
  claimTokens       BusinessClaimToken[]
  submissions       ContentSubmission[]  @relation("SubmissionBusiness")
  articles          Article[]            @relation("ArticleBusiness")
  images            BusinessImage[]
  promotionDeals    PromotionDeal[]
  promotionSales    PromotionSale[]

  @@index([postalCode])
  @@index([city, stateCode])
  @@index([sourceProvider])
  @@index([importTaskId])
}

model HereCategory {
  id        Int      @id @default(autoincrement())
  hereId    String   @unique
  name      String
  createdAt DateTime @default(now())

  @@index([name])
}

model BusinessImportTask {
  id               String                   @id @default(cuid())
  sourceProvider   String
  zipCode          String
  categories       String[]
  newBusinessLimit Int
  status           BusinessImportTaskStatus @default(RUNNING)
  message          String
  createdAt        DateTime                 @default(now())
  startedAt        DateTime                 @default(now())
  finishedAt       DateTime?
  updatedAt        DateTime                 @updatedAt
  createdByUserId  String
  createdBy        User                     @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  businesses       Business[]
  registry         Task?

  @@index([startedAt])
  @@index([status, startedAt])
}

model Advertisement {
  id                   String               @id @default(cuid())
  title                String
  description          String?
  status               AdvertisementStatus  @default(DRAFT)
  businessId           Int
  creativeFileName     String?              @unique
  creativeMimeType     String?
  creativeSize         Int?
  creativeOriginalName String?
  creativeImageId      String?
  /// Ad style (size) from a publication's promotion rates; its price per issue gives the ad's cost.
  promotionPackageId   Int?
  /// Style name and cost as set when the ad was priced (price per issue x its issues in that publication).
  styleName            String?
  costCents            Int?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  business             Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  promotionPackage     PromotionPackage?    @relation(fields: [promotionPackageId], references: [id], onDelete: SetNull)
  issues               AdvertisementIssue[]
  placements           IssuePagePlacement[]
  images               AdImage[]
  promotionDeals       PromotionDeal[]
  reviews              AdReview[]
  saleItem             PromotionSaleItem?

  @@index([status, updatedAt])
  @@index([businessId, createdAt])
}

model AdvertisementIssue {
  advertisementId String
  issueId         String
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  issue           Issue         @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@id([advertisementId, issueId])
  @@index([issueId])
}

model AdImage {
  id              String        @id @default(cuid())
  advertisementId String
  fileName        String        @unique
  originalName    String
  mimeType        String
  size            Int
  position        Int           @default(0)
  createdAt       DateTime      @default(now())
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)

  @@index([advertisementId, position])
}

model BusinessImage {
  id           String   @id @default(cuid())
  businessId   Int
  fileName     String   @unique
  originalName String
  mimeType     String
  size         Int
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, position])
}

model Issue {
  id              String               @id @default(cuid())
  publicationId   Int
  name            String
  slug            String
  description     String?
  publicationDate DateTime             @db.Date
  status          IssueStatus          @default(DRAFT)
  designJson      Json?                @db.JsonB
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  publication     Publication          @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  pages           IssuePage[]
  agentTasks      AgentTask[]
  articles        ArticleIssue[]
  advertisements  AdvertisementIssue[]
  promotionDeals  PromotionDeal[]
  promotionSales  PromotionSale[]
  saleItems       PromotionSaleItem[]

  @@unique([publicationId, publicationDate])
  @@unique([publicationId, slug])
  @@index([publicationId, status, publicationDate])
}

model IssuePage {
  id         String               @id @default(cuid())
  issueId    String
  pageNumber Int
  type       IssuePageType
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  issue      Issue                @relation(fields: [issueId], references: [id], onDelete: Cascade)
  placements IssuePagePlacement[]

  @@unique([issueId, pageNumber])
  @@index([issueId, type])
}

model IssuePagePlacement {
  id              String         @id @default(cuid())
  pageId          String
  elementId       String
  articleId       String?
  advertisementId String?
  createdAt       DateTime       @default(now())
  page            IssuePage      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  article         Article?       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  advertisement   Advertisement? @relation(fields: [advertisementId], references: [id], onDelete: Cascade)

  @@unique([pageId, elementId])
  @@index([articleId])
  @@index([advertisementId])
}

model Article {
  id                 String               @id @default(cuid())
  title              String
  body               String
  status             ArticleStatus        @default(DRAFT)
  sourceSubmissionId String?              @unique
  createdByUserId    String?
  businessId         Int?
  /// Paid promotion style (an article rate of an issue's publication) and its cost, as priced for the business.
  promotionPackageId Int?
  styleName          String?
  costCents          Int?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  sourceSubmission   ContentSubmission?   @relation("SubmissionArticle", fields: [sourceSubmissionId], references: [id], onDelete: SetNull)
  createdBy          User?                @relation("ArticleAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)
  business           Business?            @relation("ArticleBusiness", fields: [businessId], references: [id], onDelete: SetNull)
  promotionPackage   PromotionPackage?    @relation(fields: [promotionPackageId], references: [id], onDelete: SetNull)
  issues             ArticleIssue[]
  images             ArticleImage[]
  placements         IssuePagePlacement[]
  promotionDeals     PromotionDeal[]
  saleItem           PromotionSaleItem?
  /// Promote campaigns that sell this article to its business as a paid sponsored feature.
  promotionSales     PromotionSale[]

  @@index([status, updatedAt])
  @@index([createdByUserId, updatedAt])
  @@index([businessId])
}

model ArticleIssue {
  articleId String
  issueId   String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  issue     Issue   @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@id([articleId, issueId])
  @@index([issueId])
}

model ArticleImage {
  id           String   @id @default(cuid())
  articleId    String
  fileName     String   @unique
  originalName String
  mimeType     String
  size         Int
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  article      Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, position])
}

model BusinessClaimToken {
  id         String    @id @default(cuid())
  token      String    @unique @default(cuid())
  businessId Int
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model PasswordResetThrottle {
  emailHash       String   @id
  windowStartedAt DateTime @default(now())
  requestCount    Int      @default(1)

  @@index([windowStartedAt])
}

model Agent {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  slug        String      @unique
  description String
  enabled     Boolean     @default(true)
  settings    Json        @default("{}") @db.JsonB
  /// Optional human-style name and picture for agents that have no sub-agents (Designer, Creative, Copywriter).
  personaName String?
  picturePath String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  tasks       AgentTask[]
  subAgents   SubAgent[]
  registry    Task[]
}

model SubAgent {
  id             Int             @id @default(autoincrement())
  agentId        Int
  name           String
  soul           String          @db.Text
  picturePath    String?
  cellNumber     String?
  config         Json            @default("{}") @db.JsonB
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  agent          Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tasks          AgentTask[]
  emailThreads   EmailThread[]
  reachoutTasks  ReachoutTask[]
  promotionDeals PromotionDeal[]
  promotionSales PromotionSale[]

  @@index([agentId])
}

model AgentTask {
  id            String          @id @default(cuid())
  agentId       Int?
  subAgentId    Int?
  status        AgentTaskStatus @default(PENDING)
  label         String
  steps         Json            @default("[]") @db.JsonB
  result        Json?           @db.JsonB
  error         String?
  issueId       String?
  /// The submission, article or ad this task works on ("submission" | "article" | "ad"), so it
  /// can be stopped when that record is accepted.
  subjectType   String?
  subjectId     String?
  triggeredById String?
  createdAt     DateTime        @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  agent         Agent?          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  subAgent      SubAgent?       @relation(fields: [subAgentId], references: [id], onDelete: SetNull)
  issue         Issue?          @relation(fields: [issueId], references: [id], onDelete: SetNull)
  triggeredBy   User?           @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  emailThreads  EmailThread[]
  registry      Task?
  promotionDeal PromotionDeal?
  promotionSale PromotionSale?

  @@index([agentId, createdAt])
  @@index([status, createdAt])
  @@index([issueId])
  @@index([subAgentId])
  @@index([subjectType, subjectId])
}

// Unified registry of long-running operations shown in the Tasks section. Rows are
// created and kept in sync by database triggers on the backing tables (see the
// 20261014150000_task_registry migration); application code only reads them and sets
// notifiedAt. Details stay on the backing record referenced by agentTaskId,
// businessImportTaskId, or reachoutTaskId.
model Task {
  id                   Int                 @id @default(autoincrement())
  source               TaskSource
  name                 String
  status               TaskStatus
  agentId              Int?
  createdByUserId      String?
  agentTaskId          String?             @unique
  businessImportTaskId String?             @unique
  reachoutTaskId       String?             @unique
  createdAt            DateTime            @default(now())
  finishedAt           DateTime?
  notifiedAt           DateTime?
  updatedAt            DateTime            @default(now())
  agent                Agent?              @relation(fields: [agentId], references: [id], onDelete: SetNull)
  createdBy            User?               @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  agentTask            AgentTask?          @relation(fields: [agentTaskId], references: [id], onDelete: Cascade)
  businessImportTask   BusinessImportTask? @relation(fields: [businessImportTaskId], references: [id], onDelete: Cascade)
  reachoutTask         ReachoutTask?       @relation(fields: [reachoutTaskId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([agentId, createdAt])
  @@index([createdByUserId, notifiedAt])
}

model EmailThread {
  id            String         @id @default(cuid())
  subAgentId    Int
  taskId        String?
  toEmail       String
  toName        String?
  subject       String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subAgent      SubAgent       @relation(fields: [subAgentId], references: [id], onDelete: Cascade)
  task          AgentTask?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  messages      EmailMessage[]
  reachoutTask  ReachoutTask?
  promotionDeal PromotionDeal?
  promotionSale PromotionSale?

  @@index([subAgentId, createdAt])
  @@index([taskId])
}

// An ad or article sent to its advertiser for review by a Marketer sub agent, together with
// the paid promotion the Marketer is selling for the issue. The conversation runs as the
// linked AgentTask (Ongoing while open, Success when the advertiser signs up, Stopped when
// they decline) on the linked EmailThread.
model PromotionDeal {
  id                   Int                    @id @default(autoincrement())
  agentTaskId          String                 @unique
  businessId           Int
  advertisementId      String?
  articleId            String?
  issueId              String?
  /// Publication whose rate card is offered (the issue's, or the business ZIP's).
  publicationId        Int?
  subAgentId           Int?
  threadId             String?                @unique
  /// Custom instructions from staff for the Marketer, applied to every message in the conversation.
  instructions         String                 @default("") @db.Text
  /// Secret for the public ad review page (/review/[token]); a credential, not a record ID. Ads only.
  reviewToken          String?                @unique
  /// Ad creative file last emailed to the advertiser, so each new artwork is sent once.
  sentCreativeFileName String?
  contentStatus        PromotionContentStatus @default(PENDING)
  status               PromotionDealStatus    @default(PROPOSED)
  /// Changes the advertiser asked for, newest last.
  requestedChanges     String?                @db.Text
  /// Chosen package; name and price are kept as agreed even if the rate card changes later.
  packageId            Int?
  packageName          String?
  priceCents           Int?
  optedOut             Boolean                @default(false)
  followUpSentAt       DateTime?
  lastInboundAt        DateTime?
  signedUpAt           DateTime?
  createdByUserId      String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  agentTask            AgentTask              @relation(fields: [agentTaskId], references: [id], onDelete: Cascade)
  business             Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  advertisement        Advertisement?         @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  article              Article?               @relation(fields: [articleId], references: [id], onDelete: Cascade)
  issue                Issue?                 @relation(fields: [issueId], references: [id], onDelete: SetNull)
  publication          Publication?           @relation(fields: [publicationId], references: [id], onDelete: SetNull)
  package              PromotionPackage?      @relation(fields: [packageId], references: [id], onDelete: SetNull)
  subAgent             SubAgent?              @relation(fields: [subAgentId], references: [id], onDelete: SetNull)
  thread               EmailThread?           @relation(fields: [threadId], references: [id], onDelete: SetNull)
  createdBy            User?                  @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  adReviews            AdReview[]

  @@index([businessId, createdAt])
  @@index([advertisementId, createdAt])
  @@index([articleId, createdAt])
  @@index([status, createdAt])
}

// "Promote" on the Businesses page: a Marketer sub agent sells paid promotions (display ads and
// sponsored articles) in an upcoming issue to one business by email. The conversation runs as the
// linked AgentTask (Ongoing while open, Success once the business buys, Stopped when it declines)
// on the linked EmailThread. When the business agrees to buy, the Marketer creates the purchased
// draft ads and articles; each purchase is a PromotionSaleItem with its agreed price.
model PromotionSale {
  id              Int                 @id @default(autoincrement())
  agentTaskId     String              @unique
  businessId      Int
  /// The issue the campaign was launched for; other upcoming issues of the publication may be sold too.
  issueId         String?
  publicationId   Int
  /// Article this campaign sells as a paid sponsored feature (Promote on an article page); null for issue campaigns.
  articleId       String?
  subAgentId      Int?
  threadId        String?             @unique
  /// Custom instructions from staff for the Marketer, applied to every message in the conversation.
  instructions    String              @default("") @db.Text
  status          PromotionSaleStatus @default(PROPOSED)
  /// The offer currently on the table, as last stated by the Marketer: { items, discountPercent }.
  proposal        Json?               @db.JsonB
  optedOut        Boolean             @default(false)
  followUpSentAt  DateTime?
  lastInboundAt   DateTime?
  purchasedAt     DateTime?
  createdByUserId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  agentTask       AgentTask           @relation(fields: [agentTaskId], references: [id], onDelete: Cascade)
  business        Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  issue           Issue?              @relation(fields: [issueId], references: [id], onDelete: SetNull)
  article         Article?            @relation(fields: [articleId], references: [id], onDelete: SetNull)
  publication     Publication         @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  subAgent        SubAgent?           @relation(fields: [subAgentId], references: [id], onDelete: SetNull)
  thread          EmailThread?        @relation(fields: [threadId], references: [id], onDelete: SetNull)
  createdBy       User?               @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  items           PromotionSaleItem[]

  @@index([businessId, createdAt])
  @@index([issueId, createdAt])
  @@index([articleId])
  @@index([status, createdAt])
}

/// One promotion a business bought in a PromotionSale, with the draft ad or article created for it.
/// Package name and prices are kept as agreed even if the rate card changes later.
model PromotionSaleItem {
  id              Int                  @id @default(autoincrement())
  saleId          Int
  kind            PromotionPackageKind
  packageId       Int?
  packageName     String
  issueId         String?
  listPriceCents  Int
  /// Bundle discount agreed for the order this item was bought in.
  discountPercent Int                  @default(0)
  priceCents      Int
  advertisementId String?              @unique
  articleId       String?              @unique
  createdAt       DateTime             @default(now())
  sale            PromotionSale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  package         PromotionPackage?    @relation(fields: [packageId], references: [id], onDelete: SetNull)
  issue           Issue?               @relation(fields: [issueId], references: [id], onDelete: SetNull)
  advertisement   Advertisement?       @relation(fields: [advertisementId], references: [id], onDelete: SetNull)
  article         Article?             @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([issueId])
}

// One advertiser review of an ad (approval or requested changes), from the public review page
// or a classified email reply. Kept in order on the ad and given to the Creative for redesigns.
model AdReview {
  id               Int              @id @default(autoincrement())
  advertisementId  String
  promotionDealId  Int?
  source           AdReviewSource
  decision         AdReviewDecision
  comments         String           @default("") @db.Text
  /// Name the advertiser gave on the review page, if any.
  reviewerName     String?
  /// Ad creative file shown when the review was made; null when no artwork existed yet.
  creativeFileName String?
  createdAt        DateTime         @default(now())
  advertisement    Advertisement    @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  promotionDeal    PromotionDeal?   @relation(fields: [promotionDealId], references: [id], onDelete: SetNull)

  @@index([advertisementId, createdAt])
  @@index([promotionDealId])
}

model EmailMessage {
  id          String            @id @default(cuid())
  threadId    String
  messageId   String            @unique
  inReplyTo   String?
  direction   MessageDirection
  fromEmail   String
  toEmail     String
  subject     String
  bodyText    String            @db.Text
  bodyHtml    String?           @db.Text
  sentAt      DateTime?
  receivedAt  DateTime?
  createdAt   DateTime          @default(now())
  thread      EmailThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  attachments EmailAttachment[]

  @@index([threadId, createdAt])
  @@index([inReplyTo])
}

model EmailAttachment {
  id             String       @id @default(cuid())
  emailMessageId String
  fileName       String       @unique
  originalName   String
  mimeType       String
  size           Int
  createdAt      DateTime     @default(now())
  message        EmailMessage @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)

  @@index([emailMessageId])
}
